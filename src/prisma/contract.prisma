// use prisma-8
enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum TransactionStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum RecoveryStatus {
  IDENTIFIED
  ANALYZING
  ACTION_REQUIRED
  IN_PROGRESS
  RECOVERED
  FAILED
  DISMISSED
}

enum ActionType {
  EMAIL
  SMS
  WHATSAPP
  PAYMENT_LINK
  MANUAL
}

model User {
  id         Int                        @id @default(autoincrement())
  email      String                     @unique
  name       String
  role       UserRole                   @default(MEMBER)
  createdAt  TimestamptzString          @default(now())
  updatedAt  temporal.updatedAtString()

  businesses BusinessMember[]
  activities ActivityLog[]
}

model Business {
  id            Int                        @id @default(autoincrement())
  name          String
  description   String?
  currency      String                     @default("NGN")
  createdAt     TimestamptzString          @default(now())
  updatedAt     temporal.updatedAtString()

  members       BusinessMember[]
  customers     Customer[]
  transactions  Transaction[]
  recoveryCases RecoveryCase[]
  activities    ActivityLog[]
}

model BusinessMember {
  id         Int               @id @default(autoincrement())
  user       User              @relation(fields:[userId], references:[id])
  userId     Int
  business   Business          @relation(fields:[businessId], references:[id])
  businessId Int
  createdAt  TimestamptzString @default(now())

  @@unique([userId, businessId])
}

model Customer {
  id            Int                        @id @default(autoincrement())
  business      Business                   @relation(fields:[businessId], references:[id])
  businessId    Int
  name          String
  email         String?
  phone         String?
  createdAt     TimestamptzString          @default(now())
  updatedAt     temporal.updatedAtString()

  transactions  Transaction[]
  recoveryCases RecoveryCase[]
}

model Transaction {
  id            Int                @id @default(autoincrement())
  business      Business           @relation(fields:[businessId], references:[id])
  businessId    Int
  customer      Customer?          @relation(fields:[customerId], references:[id])
  customerId    Int?
  reference     String             @unique
  amount        Int
  currency      String             @default("NGN")
  status        TransactionStatus
  paidAt        TimestamptzString?
  createdAt     TimestamptzString  @default(now())

  recoveryCases RecoveryCase[]
}

model RecoveryCase {
  id              Int                @id @default(autoincrement())
  business        Business           @relation(fields:[businessId], references:[id])
  businessId      Int
  customer        Customer?          @relation(fields:[customerId], references:[id])
  customerId      Int?
  transaction     Transaction        @relation(fields:[transactionId], references:[id])
  transactionId   Int
  status          RecoveryStatus     @default(IDENTIFIED)
  reason          String
  amountAtRisk    Int
  recoveredAmount Int                @default(0)
  identifiedAt    TimestamptzString  @default(now())
  recoveredAt     TimestamptzString?

  recommendations AIRecommendation[]
  actions         RecoveryAction[]
}

model AIRecommendation {
  id             Int               @id @default(autoincrement())
  recoveryCase   RecoveryCase      @relation(fields:[recoveryCaseId], references:[id])
  recoveryCaseId Int
  recommendation String
  confidence     Float?
  reasoning      String?
  createdAt      TimestamptzString @default(now())
}

model RecoveryAction {
  id             Int                @id @default(autoincrement())
  recoveryCase   RecoveryCase       @relation(fields:[recoveryCaseId], references:[id])
  recoveryCaseId Int
  type           ActionType
  status         String             @default("PENDING")
  message        String?
  executedAt     TimestamptzString?
  createdAt      TimestamptzString  @default(now())
}

model ActivityLog {
  id         Int               @id @default(autoincrement())
  business   Business          @relation(fields:[businessId], references:[id])
  businessId Int
  user       User?             @relation(fields:[userId], references:[id])
  userId     Int?
  action     String
  metadata   Json?
  createdAt  TimestamptzString @default(now())
}
